# =============================================================================
# EdgeTilt local secrets — one file for every machine
# =============================================================================
#
# Copy this to `.env.master` (gitignored) and fill values, or copy a filled
# `.env.master` from another computer. Then:
#
#   npm run env:sync
#
# That writes the split files Vite + scripts already read:
#   .env.local
#   .env.supabase.test
#   .env.supabase.production
#   .env.cloudflare.operations   (only if CF_OPS_API_TOKEN is set)
#   .env.cloudflare.investigence (only if CF_INV_API_TOKEN is set)
#   .env.fcm-service-account.local (only if FCM_SERVICE_ACCOUNT_JSON is set)
#
# Edit THIS file. Re-run env:sync. Do not hand-edit the generated files.
# Never commit `.env.master`. Never paste filled values into Cursor chat.
#
# Test project:  kcosfvmreeiosdjdzycb  (lvslotpro.com)
# Prod project:  jtjgtucumuoswnbauxry  (edgetilt.com)
#
# Optional "Edge secret backups" block (below CF accounts) holds values that
# live in Supabase Edge secrets so a wiped project can be rebuilt. env:sync
# does not require those keys for day-to-day local work.
# =============================================================================


# -----------------------------------------------------------------------------
# Shared … same on test and prod
# -----------------------------------------------------------------------------

# Dashboard → Account → Access Tokens (CLI secrets / functions deploy)
SUPABASE_ACCESS_TOKEN=

# Apple Push (VoIP + alerts). One Auth Key works on both APNs hosts.
# Current working key id: CH5MAD3P93  (team 8932AKQW4W)
APNS_KEY_ID=
APNS_TEAM_ID=8932AKQW4W
# PEM as a single line with \n escapes (same shape Edge secrets use)
APNS_P8=

# Theo ops (@theo_ops / theo+ops@edgetilt.com) … never print these
THEO_TEST_EMAIL=theo+ops@edgetilt.com
THEO_TEST_PASSWORD=
THEO_PROD_EMAIL=theo+ops@edgetilt.com
THEO_PROD_PASSWORD=
THEO_PROD_ANON_KEY=

# Google test account (local browser / Play testing)
GOOGLE_TEST_EMAIL=
GOOGLE_TEST_PASSWORD=

# Firebase Cloud Messaging service account JSON, one line (Android push; mirrors Edge secret)
# env:sync writes it to .env.fcm-service-account.local
FCM_SERVICE_ACCOUNT_JSON=

# Stripe support helper (scripts/stripe-support.mjs) … Windows PC
STRIPE_SUPPORT_KEY_LIVE=

# Optional API keys mirrored for local scripts (also live as Edge secrets)
THE_ODDS_API_KEY=
THERUNDOWN_API_KEY=
CFBD_API_KEY=
FANTASYPROS_API_KEY=
ODDSPAPI_API_KEY=
ODDSPAPI_EMAIL=
ODDSPAPI_PASSWORD=
# Kaggle datasets (local scripts only) … Windows PC
KAGGLE_API_TOKEN=


# -----------------------------------------------------------------------------
# TEST … lvslotpro.com / kcosfvmreeiosdjdzycb
# -----------------------------------------------------------------------------

TEST_VITE_SUPABASE_URL=https://kcosfvmreeiosdjdzycb.supabase.co
TEST_VITE_SUPABASE_ANON_KEY=

TEST_SUPABASE_URL=https://kcosfvmreeiosdjdzycb.supabase.co
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_SUPABASE_DB_PASSWORD=
# Session pooler: aws-0-us-east-1
TEST_SUPABASE_DB_URL=

# Stream on the Operations CF account (same account as lvslotpro.com)
TEST_CLOUDFLARE_ACCOUNT_ID=e8b180b08329ff5de73fba3066e9c1ad
TEST_CLOUDFLARE_STREAM_API_TOKEN=

# lounge-bot-ingest worker secret (differs per project; mirrors Edge secret)
TEST_LOUNGE_BOT_FARM_INGEST_SECRET=


# -----------------------------------------------------------------------------
# PROD … edgetilt.com / jtjgtucumuoswnbauxry
