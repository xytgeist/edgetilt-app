# Copy to .env.supabase.test and/or .env.supabase.production (gitignored).
# Used by scripts/supabase-db-query.mjs and slot sync scripts.

# Test: kcosfvmreeiosdjdzycb (lvslotpro.com sandbox)
# Production: jtjgtucumuoswnbauxry (edgetilt.com)

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Dashboard → Settings → Database → Database password.
# Required for reliable CLI SQL (avoids cli_login_postgres pooler SASL / circuit-breaker failures).
SUPABASE_DB_PASSWORD=

# CollegeFootballData API (https://collegefootballdata.com/key). Used by
# scripts/sync-cfb-power-ratings.mjs for Elo/SRS CFB power board sync.
# CFBD_API_KEY=

# FantasyPros public API (https://secure.fantasypros.com/api-keys/request/).
# Used by lounge-nfl-game-fantasy Edge + local probes (x-api-key header).
# FANTASYPROS_API_KEY=

# Kalshi Trade API (optional for public market data; required for authenticated trading).
# Public NFL props use https://external-api.kalshi.com/trade-api/v2 without keys.
# Create keys in Kalshi account → API Keys. Private key is PEM (single line \n escaped OK).
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY=

# The Odds API / TheRundown (also set as Supabase Edge Function secrets).
# Mirror here for local scripts that call those APIs.
# THE_ODDS_API_KEY=
# THERUNDOWN_API_KEY=

# Optional: account access token (Dashboard → Account → Access Tokens).
# Needed for `npx supabase secrets set` / `functions deploy`. Prefer Edge Functions + Edge Function Secrets read-write only.
# SUPABASE_ACCESS_TOKEN=sbp_...

# Optional: full postgres URL (session pooler or direct). Overrides pooler-url + password builder.
# Copy from Dashboard → Connect → Session pooler. us-east-1 prod uses aws-1-us-east-1 (not aws-0).
# SUPABASE_DB_URL=postgresql://postgres.jtjgtucumuoswnbauxry:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres
