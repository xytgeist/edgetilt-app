<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.edgetilt.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>edgetilt</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Edge uses the camera for chat and Lounge video calls, scanning, and photo uploads.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Edge uses the microphone for voice and video calls and for videos you record in Lounge or Chat.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Edge accesses your photo library so you can attach images and videos in Lounge and Chat.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Edge can save images you capture or download to your photo library when you choose.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Edge uses your location to show nearby casinos and location-aware poker tools while you use the app.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.edgetilt.app.video.*</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
