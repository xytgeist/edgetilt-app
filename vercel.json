{
  "redirects": [
    {
      "source": "/guides/legends-of-the-phoenix/:path*",
      "destination": "/guides/legend-of-the-phoenix/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/privacy",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/terms",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/guidelines",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/theo",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/native/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    },
    {
      "source": "/boot/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/api/legal-document?slug=privacy" },
    { "source": "/privacy/", "destination": "/api/legal-document?slug=privacy" },
    { "source": "/terms", "destination": "/api/legal-document?slug=terms" },
    { "source": "/terms/", "destination": "/api/legal-document?slug=terms" },
    { "source": "/guidelines", "destination": "/api/legal-document?slug=guidelines" },
    { "source": "/guidelines/", "destination": "/api/legal-document?slug=guidelines" },
    { "source": "/delete-account", "destination": "/api/legal-document?slug=delete-account" },
    { "source": "/delete-account/", "destination": "/api/legal-document?slug=delete-account" },
    { "source": "/child-safety", "destination": "/api/legal-document?slug=child-safety" },
    { "source": "/child-safety/", "destination": "/api/legal-document?slug=child-safety" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/auth/confirm", "destination": "/index.html" },
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/.well-known/apple-app-site-association.json"
    },
    {
      "source": "/apple-app-site-association",
      "destination": "/.well-known/apple-app-site-association.json"
    },
    {
      "source": "/lounge/p/:postId",
      "destination": "/api/lounge-post-og?postId=:postId"
    },
    {
      "source": "/lounge/g/:eventId",
      "destination": "/api/lounge-game-og?eventId=:eventId"
    },
    {
      "source": "/u/:handle",
      "destination": "/api/lounge-profile-og?handle=:handle"
    },
    { "source": "/slot-guide-form", "destination": "/slot-guide-form.html" },
    { "source": "/advantage-play-slots", "destination": "/advantage-play-slots.html" },
    { "source": "/slots", "destination": "/slots.html" },
    { "source": "/slots/bankroll", "destination": "/slots-bankroll.html" },
    { "source": "/slots/calculators", "destination": "/slots-calculators.html" },
    { "source": "/slots/calendar", "destination": "/slots-calendar.html" },
    { "source": "/slots/logbook", "destination": "/slots-logbook.html" },
    { "source": "/guides", "destination": "/guides.html" },
    { "source": "/poker", "destination": "/poker.html" },
    { "source": "/poker/bankroll", "destination": "/poker-bankroll.html" },
    { "source": "/poker/stable", "destination": "/poker-stable.html" },
    { "source": "/sports/bet-tracker", "destination": "/sports-bet-tracker.html" },
    { "source": "/fantasy", "destination": "/fantasy.html" },
    { "source": "/slots/w2g", "destination": "/slots-w2g.html" },
    { "source": "/calculators/kelly", "destination": "/seo/calculators/kelly.html" },
    { "source": "/calculators/no-vig", "destination": "/seo/calculators/no-vig.html" },
    { "source": "/calculators/odds-converter", "destination": "/seo/calculators/odds-converter.html" },
    { "source": "/calculators/arbitrage", "destination": "/seo/calculators/arbitrage.html" },
    { "source": "/calculators/clv", "destination": "/seo/calculators/clv.html" },
    { "source": "/theo", "destination": "/api/theo" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}