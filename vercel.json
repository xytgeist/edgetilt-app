{
  "redirects": [
    {
      "source": "/guides/legends-of-the-phoenix/:path*",
      "destination": "/guides/legend-of-the-phoenix/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/privacy",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/terms",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/guidelines",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/compliance/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/reset-password", "destination": "/index.html" },
    {
      "source": "/lounge/p/:postId",
      "destination": "/api/lounge-post-og?postId=:postId"
    },
    {
      "source": "/u/:handle",
      "destination": "/api/lounge-profile-og?handle=:handle"
    },
    { "source": "/slot-guide-form", "destination": "/slot-guide-form.html" },
    { "source": "/advantage-play-slots", "destination": "/advantage-play-slots.html" },
    { "source": "/slots", "destination": "/slots.html" },
    { "source": "/slots/bankroll", "destination": "/slots-bankroll.html" },
    { "source": "/slots/calculators", "destination": "/slots-calculators.html" },
    { "source": "/slots/calendar", "destination": "/slots-calendar.html" },
    { "source": "/slots/logbook", "destination": "/slots-logbook.html" },
    { "source": "/guides", "destination": "/guides.html" },
    { "source": "/poker", "destination": "/poker.html" },
    { "source": "/poker/bankroll", "destination": "/poker-bankroll.html" },
    { "source": "/poker/stable", "destination": "/poker-stable.html" },
    { "source": "/patches", "destination": "/patches.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}